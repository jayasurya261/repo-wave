---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Analytics from '@vercel/analytics/astro';

export interface Props {
	title?: string;
	description?: string;
	jsonLd?: string;
}

const { 
	title = "Open Source Finder | Discover Repos & Issues", 
	description = "Find the best open-source repositories and issues to contribute to. Filter by language, difficulty, and jumpstart your developer journey.",
	jsonLd
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://opensourcefinder.com';
const canonicalURL = new URL(Astro.url.pathname, siteUrl);

// Default WebSite JSON-LD for every page
const websiteJsonLd = JSON.stringify({
	"@context": "https://schema.org",
	"@type": "WebSite",
	"name": "Open Source Finder",
	"url": siteUrl,
	"description": "Find the best open-source repositories and issues to contribute to. Filter by language, difficulty, and jumpstart your developer journey.",
	"potentialAction": {
		"@type": "SearchAction",
		"target": `${siteUrl}/repositories?q={search_term_string}`,
		"query-input": "required name=search_term_string"
	}
});
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6117433075666296" crossorigin="anonymous"></script>
		<ClientRouter />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />

		<!-- Resource hints for third-party services -->
		<link rel="preconnect" href="https://res.cloudinary.com" />
		<link rel="dns-prefetch" href="https://pagead2.googlesyndication.com" />
		<link rel="preconnect" href="https://pagead2.googlesyndication.com" crossorigin />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content="https://res.cloudinary.com/dqudvximt/image/upload/v1771691713/Untitled-1_z313mm.png" />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalURL} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content="https://res.cloudinary.com/dqudvximt/image/upload/v1771691713/Untitled-1_z313mm.png" />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />

		<!-- JSON-LD Structured Data: WebSite (default on all pages) -->
		<script type="application/ld+json" set:html={websiteJsonLd} />

		<!-- JSON-LD Structured Data: Page-specific -->
		{jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
		<!-- Dark-mode: apply class before first paint to avoid flash -->
		<script is:inline>
			function applyStoredTheme() {
				var saved = localStorage.getItem('theme');
				var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
				if (saved === 'dark' || (!saved && prefersDark)) {
					document.documentElement.classList.add('dark');
				} else {
					document.documentElement.classList.remove('dark');
				}
			}
			applyStoredTheme();
			// Transfer dark class to incoming document before it's swapped in,
			// preventing a flash of the light theme during View Transitions.
			document.addEventListener('astro:before-swap', function(e) {
				if (document.documentElement.classList.contains('dark')) {
					e.newDocument.documentElement.classList.add('dark');
				} else {
					e.newDocument.documentElement.classList.remove('dark');
				}
			});
			document.addEventListener('astro:page-load', applyStoredTheme);
		</script>
		<style>
			html { margin: 0; padding: 0; border: none; overflow-y: scroll; }
			body { margin: 0 !important; padding: 0 !important; }
			* { box-sizing: border-box; }
		</style>
	</head>
	<body class="bg-gray-50 dark:bg-gray-950 flex flex-col min-h-screen m-0 p-0">
		<!-- SVG Sprite for icons -->
		<svg xmlns="http://www.w3.org/2000/svg" style="display:none">
			<symbol id="icon-bookmark-outline" viewBox="0 0 24 24">
				<path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" fill="none"/>
			</symbol>
			<symbol id="icon-bookmark-solid" viewBox="0 0 24 24">
				<path fill="currentColor" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/>
			</symbol>
			<symbol id="icon-heart-outline" viewBox="0 0 24 24">
				<path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" fill="none"/>
			</symbol>
			<symbol id="icon-heart-solid" viewBox="0 0 24 24">
				<path fill="currentColor" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
			</symbol>
			<symbol id="icon-star" viewBox="0 0 20 20">
				<path fill="currentColor" d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
			</symbol>
			<symbol id="icon-fork" viewBox="0 0 24 24">
				<path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" fill="none"/>
			</symbol>
			<symbol id="icon-chevron-down" viewBox="0 0 24 24">
				<path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" fill="none"/>
			</symbol>
		</svg>

		<Navbar />
		<main class="flex-grow">
			<slot />
		</main>
		<Footer />
		<Analytics />

		<!-- Onboarding Modal -->
		<div id="onboardingOverlay" class="fixed inset-0 z-50 hidden bg-black/50 items-center justify-center p-4" style="display: none;">
			<style>
				#onboardingOverlay:not(.hidden) {
					display: flex;
				}
			</style>
			<div class="bg-white dark:bg-gray-900 rounded-2xl shadow-2xl w-full max-w-md p-8">
				<div id="onboardingSteps" class="mb-6"></div>

				<!-- Step Indicator -->
				<div id="onboardingIndicator" class="mb-6"></div>

				<!-- Navigation Buttons -->
				<div class="flex gap-3">
					<button id="onboardingPrev" class="flex-1 px-4 py-2.5 bg-gray-200 dark:bg-gray-800 text-gray-900 dark:text-white font-semibold rounded-lg hover:bg-gray-300 dark:hover:bg-gray-700 transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
						Back
					</button>
					<button id="onboardingNext" class="flex-1 px-4 py-2.5 bg-green-600 hover:bg-green-700 text-white font-semibold rounded-lg transition-colors">
						Next
					</button>
				</div>

				<!-- Close button -->
				<button id="onboardingClose" onclick="document.getElementById('onboardingOverlay').classList.add('hidden')" class="absolute top-4 right-4 text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200">
					<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
					</svg>
				</button>
			</div>
		</div>

		<!-- Report Issue Button -->
		<button id="reportBugBtn" title="Report a bug or security issue"
			class="fixed bottom-6 right-6 z-40 bg-green-600 hover:bg-green-700 active:scale-95 text-white rounded-full w-10 h-10 flex items-center justify-center transition-all shadow-lg">
			<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<rect x="8" y="6" width="8" height="13" rx="4"/>
				<path d="M19 9h-3M5 9h3M19 14h-3M5 14h3"/>
				<path d="M10 4.5c0-.828.895-1.5 2-1.5s2 .672 2 1.5"/>
				<path d="M10.5 3.5L9 2M13.5 3.5L15 2"/>
			</svg>
		</button>

		<!-- Report Issue Modal -->
		<div id="reportModal" class="fixed bottom-20 right-6 z-50 hidden w-80 bg-white dark:bg-gray-900 rounded-2xl shadow-2xl border border-gray-200 dark:border-gray-700 overflow-hidden">
			<!-- Header -->
			<div class="flex items-center justify-between px-4 py-3 bg-gray-50 dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700">
				<h3 class="text-sm font-bold text-gray-900 dark:text-gray-100 flex items-center gap-2">
					<svg class="w-4 h-4 text-green-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<rect x="8" y="6" width="8" height="13" rx="4"/>
						<path d="M19 9h-3M5 9h3M19 14h-3M5 14h3"/>
					</svg>
					Report an Issue
				</h3>
				<button id="reportModalClose" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 transition-colors p-0.5">
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
				</button>
			</div>

			<!-- Form -->
			<div class="p-4 space-y-3">
				<!-- Type toggle -->
				<div class="grid grid-cols-2 gap-2">
					<button data-report-type="bug"
						class="report-type-btn flex items-center justify-center gap-1.5 px-3 py-2 rounded-lg text-xs font-semibold border-2 border-orange-200 text-orange-700 dark:border-orange-800 dark:text-orange-400 hover:bg-orange-50 dark:hover:bg-orange-950 transition-all">
						Bug
					</button>
					<button data-report-type="security"
						class="report-type-btn flex items-center justify-center gap-1.5 px-3 py-2 rounded-lg text-xs font-semibold border-2 border-red-200 text-red-700 dark:border-red-800 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-950 transition-all">
						Security
					</button>
					<button data-report-type="feature"
						class="report-type-btn flex items-center justify-center gap-1.5 px-3 py-2 rounded-lg text-xs font-semibold border-2 border-blue-200 text-blue-700 dark:border-blue-800 dark:text-blue-400 hover:bg-blue-50 dark:hover:bg-blue-950 transition-all">
						Feature
					</button>
					<button data-report-type="other"
						class="report-type-btn flex items-center justify-center gap-1.5 px-3 py-2 rounded-lg text-xs font-semibold border-2 border-gray-200 text-gray-600 dark:border-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-800 transition-all">
						Other
					</button>
				</div>

				<!-- Title -->
				<div>
					<label class="block text-xs font-medium text-gray-600 dark:text-gray-400 mb-1">Title <span class="text-red-500">*</span></label>
					<input id="reportTitle" type="text" placeholder="Brief description…" maxlength="120"
						class="w-full px-3 py-2 text-sm rounded-lg border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-gray-100 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-green-500/40 transition" />
				</div>

				<!-- Description -->
				<div>
					<label class="block text-xs font-medium text-gray-600 dark:text-gray-400 mb-1">Details</label>
					<textarea id="reportDescription" rows="3" placeholder="Steps to reproduce, expected vs actual behavior…" maxlength="1000"
						class="w-full px-3 py-2 text-sm rounded-lg border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-gray-100 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-green-500/40 transition resize-none"></textarea>
				</div>

				<!-- Submit -->
				<button id="reportSubmitBtn"
					class="w-full px-4 py-2.5 bg-green-600 hover:bg-green-700 disabled:bg-gray-300 dark:disabled:bg-gray-700 disabled:cursor-not-allowed text-white font-semibold rounded-lg transition-colors text-sm flex items-center justify-center gap-2">
					Submit Report
				</button>

				<!-- Status message -->
				<p id="reportStatus" class="hidden text-xs text-center font-medium"></p>
			</div>
		</div>

		<script is:inline>
			(function() {
				var selectedType = 'bug';

				var typeColors = {
					bug:      '#ea580c',
					security: '#dc2626',
					feature:  '#2563eb',
					other:    '#6b7280',
				};

				function applyTypeStyles() {
					document.querySelectorAll('.report-type-btn').forEach(function(btn) {
						var t = btn.getAttribute('data-report-type');
						var isActive = t === selectedType;
						btn.setAttribute('data-active', isActive ? 'true' : 'false');
						if (isActive) {
							btn.style.backgroundColor = typeColors[t] || '#6b7280';
							btn.style.borderColor = typeColors[t] || '#6b7280';
							btn.style.color = '#fff';
						} else {
							btn.style.backgroundColor = '';
							btn.style.borderColor = '';
							btn.style.color = '';
						}
					});
				}

				function openModal() {
					var modal = document.getElementById('reportModal');
					if (modal) {
						modal.classList.remove('hidden');
						applyTypeStyles();
						document.getElementById('reportTitle').focus();
					}
				}

				function closeModal() {
					var modal = document.getElementById('reportModal');
					if (modal) modal.classList.add('hidden');
					var status = document.getElementById('reportStatus');
					if (status) { status.classList.add('hidden'); status.textContent = ''; }
				}

				function resetForm() {
					selectedType = 'bug';
					var title = document.getElementById('reportTitle');
					var desc = document.getElementById('reportDescription');
					if (title) title.value = '';
					if (desc) desc.value = '';
					applyTypeStyles();
				}

				document.addEventListener('astro:page-load', function() {
					var openBtn = document.getElementById('reportBugBtn');
					var closeBtn = document.getElementById('reportModalClose');
					var submitBtn = document.getElementById('reportSubmitBtn');

					if (openBtn) {
						openBtn.addEventListener('click', function(e) {
							e.stopPropagation();
							var modal = document.getElementById('reportModal');
							if (modal && modal.classList.contains('hidden')) {
								openModal();
							} else {
								closeModal();
							}
						});
					}

					if (closeBtn) {
						closeBtn.addEventListener('click', closeModal);
					}

					document.querySelectorAll('.report-type-btn').forEach(function(btn) {
						btn.addEventListener('click', function() {
							selectedType = btn.getAttribute('data-report-type');
							applyTypeStyles();
						});
					});

					document.addEventListener('click', function(e) {
						var modal = document.getElementById('reportModal');
						var openBtn = document.getElementById('reportBugBtn');
						if (modal && !modal.classList.contains('hidden') &&
							!modal.contains(e.target) && e.target !== openBtn && !openBtn.contains(e.target)) {
							closeModal();
						}
					});

					if (submitBtn) {
						submitBtn.addEventListener('click', async function() {
							var title = document.getElementById('reportTitle').value.trim();
							var desc = document.getElementById('reportDescription').value.trim();
							var status = document.getElementById('reportStatus');

							if (!title) {
								status.textContent = 'Please enter a title.';
								status.className = 'text-xs text-center font-medium text-red-600 dark:text-red-400';
								status.classList.remove('hidden');
								return;
							}

							submitBtn.disabled = true;
							submitBtn.textContent = 'Submitting…';

							try {
								var res = await fetch('/api/report', {
									method: 'POST',
									headers: { 'Content-Type': 'application/json' },
									body: JSON.stringify({
										type: selectedType,
										title: title,
										description: desc || null,
										page_url: window.location.href,
									}),
								});

								if (res.ok) {
									status.textContent = '✓ Report submitted. Thank you!';
									status.className = 'text-xs text-center font-medium text-green-600 dark:text-green-400';
									status.classList.remove('hidden');
									setTimeout(function() { closeModal(); resetForm(); }, 2000);
								} else {
									var err = await res.json();
									status.textContent = err.error || 'Failed to submit. Please try again.';
									status.className = 'text-xs text-center font-medium text-red-600 dark:text-red-400';
									status.classList.remove('hidden');
								}
							} catch (e) {
								status.textContent = 'Network error. Please try again.';
								status.className = 'text-xs text-center font-medium text-red-600 dark:text-red-400';
								status.classList.remove('hidden');
							} finally {
								submitBtn.disabled = false;
								submitBtn.textContent = 'Submit Report';
							}
						});
					}
				});
			})();
		</script>

		<!-- Auth Toast -->
		<div id="auth-toast" class="fixed bottom-6 left-6 z-[100] transform -translate-x-[calc(100%+2rem)] transition-transform duration-500 ease-out pointer-events-none">
			<div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl shadow-2xl px-5 py-4 flex items-center gap-3 w-[calc(100vw-3rem)] sm:w-auto sm:min-w-[320px] pointer-events-auto">
				<div class="flex-shrink-0 w-10 h-10 bg-green-100 dark:bg-green-900/40 rounded-full flex items-center justify-center">
					<svg class="w-5 h-5 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
					</svg>
				</div>
				<div class="flex-1">
					<p class="text-sm font-semibold text-gray-900 dark:text-gray-100">Sign in required</p>
					<p class="text-xs text-gray-500 dark:text-gray-400">Authenticate to use favourites & bookmarks</p>
				</div>
				<div class="flex-shrink-0">
					<span id="auth-toast-countdown" class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-green-500 text-white text-sm font-bold">5</span>
				</div>
			</div>
			<!-- Progress bar -->
			<div class="mt-1 mx-2 h-1 bg-gray-200 dark:bg-gray-700 rounded-full overflow-hidden">
				<div id="auth-toast-progress" class="h-full bg-green-500 rounded-full transition-all duration-1000 ease-linear" style="width: 100%"></div>
			</div>
		</div>

		<script is:inline>
			window._authToastTimer = null;
			window.showAuthToast = function() {
				// Prevent multiple toasts
				if (window._authToastTimer) return;

				var toast = document.getElementById('auth-toast');
				var countdown = document.getElementById('auth-toast-countdown');
				var progress = document.getElementById('auth-toast-progress');
				if (!toast || !countdown || !progress) return;

				// Slide in
				toast.classList.remove('-translate-x-[calc(100%+2rem)]');
				toast.classList.add('translate-x-0');

				var seconds = 5;
				countdown.textContent = seconds;
				progress.style.width = '100%';

				window._authToastTimer = setInterval(function() {
					seconds--;
					countdown.textContent = seconds;
					progress.style.width = (seconds / 5 * 100) + '%';

					if (seconds <= 0) {
						clearInterval(window._authToastTimer);
						window._authToastTimer = null;
						window.location.href = '/login';
					}
				}, 1000);
			};
		</script>

		<script is:inline src="/onboarding.js"></script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
