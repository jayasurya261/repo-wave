---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import SidebarFilter from '../components/SidebarFilter.astro';
import SearchBar from '../components/SearchBar.astro';
import RepoCard from '../components/RepoCard.astro';
import IssueCard from '../components/IssueCard.astro';
import { fetchAllRecords } from '../lib/fetchAll';

const PAGE_SIZE = 20;

let repos: any[] = [];
let issues: any[] = [];
let fetchFailed = false;
let repoCount = 0;
let issueCount = 0;

try {
	// Fetch only first page of repos for initial render
	repos = await fetchAllRecords('repos', '*', 'stars', false, PAGE_SIZE);
	const issuesRaw = await fetchAllRecords('issues', '*, repos(language)', 'created_at', false, PAGE_SIZE);
	issues = issuesRaw?.map((issue: any) => ({
		...issue,
		language: issue.repos?.language || ''
	})) ?? [];

	// Get total counts for social proof
	const { supabase } = await import('../lib/supabase');
	const { count: rCount } = await supabase.from('repos').select('*', { count: 'exact', head: true });
	const { count: iCount } = await supabase.from('issues').select('*', { count: 'exact', head: true });
	repoCount = rCount || 0;
	issueCount = iCount || 0;
} catch (err) {
	console.error('[index] Failed to fetch data from Supabase:', err);
	fetchFailed = true;
}

// Unique languages – fetched separately with a small query
let uniqueLanguages: string[] = [];
try {
	const langRows = await fetchAllRecords('repos', 'language', 'language', true, 5000);
	uniqueLanguages = [...new Set(langRows.map((r: any) => r.language).filter(Boolean))].sort() as string[];
} catch { /* non-fatal */ }

// Build issuesByRepo map from the already-fetched 20 issues
const issuesByRepo = new Map<string, any[]>();
for (const issue of issues) {
	const key = issue.repo_id;
	if (!issuesByRepo.has(key)) issuesByRepo.set(key, []);
	issuesByRepo.get(key)!.push(issue);
}

// Data freshness: most recently scraped issue timestamp
let lastUpdated: string | null = null;
try {
	const { supabase } = await import('../lib/supabase');
	const { data } = await supabase
		.from('issues')
		.select('created_at')
		.order('created_at', { ascending: false })
		.limit(1)
		.single();
	if (data?.created_at) {
		const diff = Date.now() - new Date(data.created_at).getTime();
		const h = Math.floor(diff / 36e5);
		const d = Math.floor(diff / 864e5);
		lastUpdated = d >= 1 ? `${d}d ago` : h >= 1 ? `${h}h ago` : 'just now';
	}
} catch { /* non-fatal */ }
---

<Layout title=”Find Your First Open Source Issue | Repo Wave - Beginner Friendly Guide” description=”Discover beginner-friendly open-source issues and learn how to contribute. Browse 5000+ repositories with curated 'good first issues' for developers of all levels.”>
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

		<!-- Hero Section with Value Proposition -->
		<section class="py-12 sm:py-16 lg:py-20 border-b border-green-200 dark:border-green-900/30">
			<div class="text-center mb-12">
				<h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-gray-900 dark:text-white tracking-tight mb-4">
					Find Your First <span class="text-green-600 dark:text-green-400">Open Source Issue</span>
				</h1>
				<p class="text-xl text-gray-600 dark:text-gray-400 max-w-3xl mx-auto mb-8">
					Discover beginner-friendly issues and start contributing to open source today. Learn by doing with real projects.
				</p>

				<!-- Social Proof Stats -->
				<div class="grid grid-cols-3 gap-4 sm:gap-8 max-w-2xl mx-auto mb-10">
					<div class="bg-green-50 dark:bg-green-900/30 rounded-lg p-4 border border-green-200 dark:border-green-800">
						<div class="text-2xl sm:text-3xl font-bold text-green-600 dark:text-green-400">{repoCount.toLocaleString()}</div>
						<div class="text-sm text-gray-600 dark:text-gray-400">Repositories</div>
					</div>
					<div class="bg-green-50 dark:bg-green-900/30 rounded-lg p-4 border border-green-200 dark:border-green-800">
						<div class="text-2xl sm:text-3xl font-bold text-green-600 dark:text-green-400">{issueCount.toLocaleString()}</div>
						<div class="text-sm text-gray-600 dark:text-gray-400">Issues Indexed</div>
					</div>
					<div class="bg-green-50 dark:bg-green-900/30 rounded-lg p-4 border border-green-200 dark:border-green-800">
						<div class="text-2xl sm:text-3xl font-bold text-green-600 dark:text-green-400">{uniqueLanguages.length}</div>
						<div class="text-sm text-gray-600 dark:text-gray-400">Languages</div>
					</div>
				</div>

				<!-- CTA Buttons -->
				<div class="flex flex-col sm:flex-row gap-4 justify-center">
					<a href="/issues" class="inline-flex items-center justify-center px-8 py-3 bg-green-600 hover:bg-green-700 text-white font-semibold rounded-lg transition-colors shadow-sm">
						<svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
						</svg>
						Discover Issues Now
					</a>
					<a href="/guide" class="inline-flex items-center justify-center px-8 py-3 border-2 border-green-600 text-green-600 dark:text-green-400 dark:border-green-400 hover:bg-green-50 dark:hover:bg-green-900/20 font-semibold rounded-lg transition-colors">
						<svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9 5h.01M12 12H9m3 0h3"/>
						</svg>
						Learn How to Contribute
					</a>
				</div>
			</div>

			<!-- Key Benefits Section -->
			<div class="grid grid-cols-1 sm:grid-cols-3 gap-8 mt-16">
				<div class="text-center">
					<div class="flex justify-center mb-4">
						<div class="p-3 bg-green-100 dark:bg-green-900/30 rounded-lg border border-green-200 dark:border-green-800">
							<svg class="w-8 h-8 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/>
							</svg>
						</div>
					</div>
					<h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">Curated for Beginners</h3>
					<p class="text-gray-600 dark:text-gray-400">Every issue is labeled as "good first issue" or "beginner-friendly" by maintainers.</p>
				</div>

				<div class="text-center">
					<div class="flex justify-center mb-4">
						<div class="p-3 bg-green-100 dark:bg-green-900/30 rounded-lg border border-green-200 dark:border-green-800">
							<svg class="w-8 h-8 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
							</svg>
						</div>
					</div>
					<h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">Smart Filtering</h3>
					<p class="text-gray-600 dark:text-gray-400">Filter by language, difficulty, and project type to find issues that match your skills.</p>
				</div>

				<div class="text-center">
					<div class="flex justify-center mb-4">
						<div class="p-3 bg-green-100 dark:bg-green-900/30 rounded-lg border border-green-200 dark:border-green-800">
							<svg class="w-8 h-8 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
							</svg>
						</div>
					</div>
					<h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">Track Your Growth</h3>
					<p class="text-gray-600 dark:text-gray-400">Earn points for contributions and build your public developer profile.</p>
				</div>
			</div>
		</section>

		{fetchFailed && (
			<div class="flex items-start gap-3 bg-amber-50 border border-amber-300 text-amber-800 px-5 py-4 rounded-xl my-8 shadow-sm">
				<svg class="flex-shrink-0 mt-0.5" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
					<line x1="12" y1="9" x2="12" y2="13"/>
					<line x1="12" y1="17" x2="12.01" y2="17"/>
				</svg>
				<div>
					<p class="font-semibold text-sm">Service temporarily unavailable</p>
					<p class="text-sm mt-0.5 text-amber-700">We couldn&apos;t load the latest data right now. Please try refreshing the page in a moment.</p>
				</div>
			</div>
		)}

		<div class="py-10">

		<!-- Main Layout with Sidebar and Content -->
		<div class="flex flex-col md:flex-row gap-8">
			
			<SidebarFilter uniqueLanguages={uniqueLanguages} />

			<!-- Main Content Area -->
			<main class="flex-grow min-w-0">
				
				<SearchBar />

				<!-- Issues Section -->
				<section class="mb-12">
					<h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6 flex items-center gap-2">
						Recent Issues
						<span id="issueCount" class="text-sm font-normal text-gray-500 dark:text-gray-400 bg-gray-100 dark:bg-gray-800 px-2 py-0.5 rounded-full">{issues ? issues.length : 0}</span>
						{lastUpdated && (
							<span class="ml-auto text-xs font-normal text-gray-400 dark:text-gray-500 flex items-center gap-1" title="When data was last scraped">
								<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
								Updated {lastUpdated}
							</span>
						)}
					</h1>
					{issues && issues.length > 0 ? (
						<div id="issueList" class="bg-white dark:bg-gray-900 rounded-xl shadow-sm border border-green-500 divide-y divide-gray-100 dark:divide-gray-800">
							{issues.map((issue: any) => <IssueCard issue={issue} />)}
						</div>
					) : (
						<p class="text-gray-500">No issues found.</p>
					)}
					<div id="noIssuesMsg" class="hidden text-gray-500 dark:text-gray-400 mt-4 p-4 bg-gray-50 dark:bg-gray-900 rounded-lg border border-gray-100 dark:border-gray-800 text-center">No issues match your search.</div>
					
					<div class="mt-6 flex justify-center">
						<button id="showMoreIssuesBtn" class="hidden px-6 py-2.5 bg-white dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-full text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800 hover:text-indigo-600 dark:hover:text-indigo-400 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors shadow-sm">
							Show More Issues
						</button>
					</div>
				</section>

				<!-- Repos Section -->
				<section>
					<h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6 flex items-center gap-2">
						Repositories
						<span id="repoCount" class="text-sm font-normal text-gray-500 dark:text-gray-400 bg-gray-100 dark:bg-gray-800 px-2 py-0.5 rounded-full">{repos ? repos.length : 0}</span>
					</h2>
					{repos && repos.length > 0 ? (
						<div id="repoList" class="grid grid-cols-1 xl:grid-cols-2 gap-6">
							{repos.map((repo: any) => <RepoCard repo={repo} repoIssues={issuesByRepo.get(repo.full_name) ?? []} />)}
						</div>
					) : (
						<p class="text-gray-500">No repositories found.</p>
					)}
					<div id="noReposMsg" class="hidden text-gray-500 dark:text-gray-400 mt-4 p-4 bg-gray-50 dark:bg-gray-900 rounded-lg border border-gray-100 dark:border-gray-800 text-center">No repositories match your filter.</div>
					
					<div class="mt-6 flex justify-center">
						<button id="showMoreReposBtn" class="hidden px-6 py-2.5 bg-white dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-full text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800 hover:text-indigo-600 dark:hover:text-indigo-400 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors shadow-sm">
							Show More Repositories
						</button>
					</div>
				</section>

			</main>
		</div>
	</div>
</Layout>

<script is:inline src="/filter.js"></script>
