---
export const prerender = false;
export const revalidate = 60; // ISR: Revalidate cached page every 60 seconds
import Layout from '../layouts/Layout.astro';
import SidebarFilter from '../components/SidebarFilter.astro';
import SearchBar from '../components/SearchBar.astro';
import IssueCard from '../components/IssueCard.astro';
import { fetchAllRecords } from '../lib/fetchAll';

const PAGE_SIZE = 20;

let issues: any[] = [];
let fetchFailed = false;
let uniqueLanguages: string[] = [];
let lastUpdated: string | null = null;

try {
	const { supabase } = await import('../lib/supabase');

	// Parallelize all independent queries with Promise.all
	const [issuesResult, langResult, latestIssueResult] = await Promise.all([
		// Fetch initial 20 issues with repo language join (direct query, not via fetchAllRecords)
		supabase.from('issues').select('*, repos(language)').order('created_at', { ascending: false }).range(0, PAGE_SIZE - 1),
		// Get unique languages (single query instead of 5 batch queries)
		supabase.from('repos').select('language').not('language', 'is', null).order('language'),
		// Get latest issue for "updated" timestamp
		supabase.from('issues').select('created_at').order('created_at', { ascending: false }).limit(1).single(),
	]);

	// Extract issues data
	const issuesRaw = issuesResult.data ?? [];
	issues = issuesRaw?.map((issue: any) => ({
		...issue,
		language: issue.repos?.language || ''
	})) ?? [];

	// Process languages with deduplication
	const langRows = langResult.data ?? [];
	uniqueLanguages = [...new Set(langRows.map((r: any) => r.language).filter(Boolean))].sort() as string[];

	// Extract latest issue timestamp
	if (latestIssueResult.data?.created_at) {
		const diff = Date.now() - new Date(latestIssueResult.data.created_at).getTime();
		const h = Math.floor(diff / 36e5), d = Math.floor(diff / 864e5);
		lastUpdated = d >= 1 ? `${d}d ago` : h >= 1 ? `${h}h ago` : 'just now';
	}
} catch (err) {
	console.error('[issues] Failed to fetch data from Supabase:', err);
	fetchFailed = true;
}
---
---

<Layout title="Beginner-Friendly Issues - Find Your First Open Source Issue | Repo Wave" description="Browse thousands of beginner-friendly open-source issues. Find good-first-issues, help-wanted tags, and start your open-source journey today. Filter by language and difficulty.">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 pt-0">

		{fetchFailed && (
			<div class="flex items-start gap-3 bg-amber-50 border border-amber-300 text-amber-800 px-5 py-4 rounded-xl mb-8 shadow-sm">
				<svg class="flex-shrink-0 mt-0.5" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
					<line x1="12" y1="9" x2="12" y2="13"/>
					<line x1="12" y1="17" x2="12.01" y2="17"/>
				</svg>
				<div>
					<p class="font-semibold text-sm">Service temporarily unavailable</p>
					<p class="text-sm mt-0.5 text-amber-700">We couldn&apos;t load the latest issues right now. Please try refreshing the page in a moment.</p>
				</div>
			</div>
		)}

		<!-- Main Layout with Sidebar and Content -->
		<div class="flex flex-col md:flex-row gap-8">
			
			<SidebarFilter uniqueLanguages={uniqueLanguages} />

			<!-- Main Content Area -->
			<main class="flex-grow min-w-0">

				<SearchBar />

				<!-- Issues Section -->
				<section class="mb-12">
					<!-- Issue Sort Tabs -->
					<div class="flex gap-2 mb-6" data-active-sort="recent">
						<button data-sort="recent" data-active="true" class="sort-tab px-3 py-1.5 rounded-full text-sm font-medium border border-green-600 bg-green-600 text-white transition-colors dark:border-green-600">Recent</button>
						<button data-sort="trending" data-active="false" class="sort-tab px-3 py-1.5 rounded-full text-sm font-medium border border-gray-300 text-gray-700 hover:bg-gray-50 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-800 transition-colors">This Week</button>
						<button data-sort="easy" data-active="false" class="sort-tab px-3 py-1.5 rounded-full text-sm font-medium border border-gray-300 text-gray-700 hover:bg-gray-50 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-800 transition-colors">Easiest</button>
					</div>

					<h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6 flex items-center gap-2">
						All Issues
						<span id="issueCount" class="text-sm font-normal text-gray-500 dark:text-gray-400 bg-gray-100 dark:bg-gray-800 px-2 py-0.5 rounded-full">{issues ? issues.length : 0}</span>
						{lastUpdated && (
							<span class="ml-auto text-xs font-normal text-gray-400 dark:text-gray-500 flex items-center gap-1" title="When data was last scraped">
								<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
								Updated {lastUpdated}
							</span>
						)}
					</h1>
					{issues && issues.length > 0 ? (
						<div id="issueList" class="bg-white dark:bg-gray-900 rounded-xl shadow-sm border border-green-500 divide-y divide-gray-100 dark:divide-gray-800">
							{issues.map((issue: any) => <IssueCard issue={issue} />)}
						</div>
					) : (
						<p class="text-gray-500">No issues found.</p>
					)}
					<div id="noIssuesMsg" class="hidden text-gray-500 dark:text-gray-400 mt-4 p-4 bg-gray-50 dark:bg-gray-900 rounded-lg border border-gray-100 dark:border-gray-800 text-center">No issues match your search.</div>
					<div id="paginationContainer" class="mt-8"></div>
				</section>
                
                <!-- Hidden repo elements so the shared filter.js doesn't crash if it looks for them -->
                <div id="repoCount" class="hidden text-sm font-normal text-gray-500 bg-gray-100 px-2 py-0.5 rounded-full"></div>
                <div id="noReposMsg" class="hidden"></div>
                <button id="showMoreReposBtn" class="hidden"></button>

			</main>
		</div>
	</div>
</Layout>

<script is:inline src="/filter.js"></script>


